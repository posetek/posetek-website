  "evidence": [
    {
      "id": "youth-plyometric-2014",
      "url": "https://jssm.org/volume13/iss2/cap/jssm-13-287.pdf",
      "population": "54 boys aged 8-14; seven-week plyometric program comparing 30, 60 and 120 s interset recovery.",
      "finding": "Similar measured improvements across groups.",
      "limitation": "Not proof of equivalence, exact PoseTek drill performance quality, safety or all maturity groups."
    },
    {
      "id": "maturity-plyometric-2019",
      "url": "https://pubmed.ncbi.nlm.nih.gov/31159655/",
      "population": "Boys aged 10-17, grouped by biological maturity; 30 versus 120 s recovery.",
      "finding": "Post-PHV participants benefited more from 120 s; pre-PHV outcomes were similar.",
      "limitation": "Do not infer maturity from chronological age or shorten every power drill."
    },
    {
      "id": "sprint-2017",
      "url": "https://journals.plos.org/plosone/article?id=10.1371/journal.pone.0171462",
      "population": "29 trained teenage male soccer players; repeated 30 m sprint program with 15 versus 30 s passive recovery and two-minute set rest.",
      "finding": "30 s maintained sprint performance better; 15 s favored conditioning adaptations.",
      "limitation": "A repeated-sprint protocol is not a matched trial for these acceleration or cutting drills."
    },
    {
      "id": "nordic-2021",
      "url": "https://repository.essex.ac.uk/31587/1/i1062-6050-56-9-952.pdf",
      "population": "10 trained adult men; two sets of six Nordic repetitions with 60 versus 180 s rest.",
      "finding": "60 s was sufficient in that acute protocol; longer rest may help force.",
      "limitation": "Not pediatric evidence or a matched assisted-Nordic trial; retain the authored 90 s lower bound."
    },
    {
      "id": "nsca-speed-quality",
      "url": "https://www.nsca.com/education/articles/kinetic-select/designing-speed-training-sessions/",
      "population": "Professional speed-training guidance.",
      "finding": "High quality sprinting requires adequate recovery and individualized volume.",
      "limitation": "Guidance supports preserving longer maximum-speed recovery; not an exact interval experiment."
    },
    {
      "id": "acsm-youth-strength",
      "url": "https://www.acsm.org/wp-content/uploads/2025/02/NYSHSI-Youth-Resistance-Training-PDF.pdf",
      "population": "General youth resistance-training guidance (2015 publication).",
      "finding": "One-minute recovery can be appropriate; longer recovery may be needed as loads and sets increase.",
      "limitation": "Guidance rather than a matched squat-to-box rest trial; supervision and technique remain required."
    }
  ]
}
